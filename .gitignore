# Keystore files (keep these out of version control for security)
*.jks
*.keystore
keystore.properties

# Large model files (optional - uncomment if you want to ignore all models)
# app/src/main/assets/*.tflite
# app/src/main/assets/*.pb
# app/src/main/assets/*.pth

# Gradle wrapper (optional - uncomment if you want to ignore gradle wrapper)
# gradle/wrapper/gradle-wrapper.jar
# gradle/wrapper/gradle-wrapper.properties

# Keep essential files
!gradle/wrapper/gradle-wrapper.properties
!gradle.properties
!settings.gradle.kts
!build.gradle.kts
!app/build.gradle.kts

# Keep source code and resources
!app/src/main/java/**/*
!app/src/main/kotlin/**/*
!app/src/main/res/**/*
!app/src/main/AndroidManifest.xml

# Keep essential configuration files
!app/proguard-rules.pro
!app/src/main/res/xml/**/*

# Keep documentation
!README.md
!*.md

# Keep essential assets (but ignore large model files)
!app/src/main/assets/
app/src/main/assets/*.tflite
app/src/main/assets/*.pb
app/src/main/assets/*.pth
app/src/main/assets/*.onnx
app/src/main/assets/*.h5
app/src/main/assets/*.hdf5
app/src/main/assets/*.model
app/src/main/assets/*.weights

# Keep small essential assets
!app/src/main/assets/*.xml
!app/src/main/assets/*.json
!app/src/main/assets/*.txt

# Ensure all PNG images in the repo (app source/res/assets) are committed
!app/src/main/**/*.png

app/release/*