<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="@+id/controlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Info Button -->
    <TextView
        android:id="@+id/infoButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/info_button_background"
        android:contentDescription="Camera features guide"
        android:gravity="center"
        android:text="ℹ"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/controlsContainer" />

    <!-- Info Panel -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/info_panel_background"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        android:elevation="999dp"
        app:layout_constraintBottom_toTopOf="@+id/controlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Info Panel Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="Camera Features Guide"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Info Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- NV Button Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_info_background"
                        android:padding="8dp"
                        android:text="NV - Night Vision"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Two modes: Regular NV (histogram equalization for low light) and ML NV (AI-enhanced). Use the sliders to adjust intensity or sensitivity."
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <!-- IMG Button Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_info_background"
                        android:padding="8dp"
                        android:text="IMG – Image Processing"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• ED (Edge Detection): Highlights contours and edges\n• COL (Color Adjustment): Adjust red, green, and blue channels with sliders"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <!-- ROB Button Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_info_background"
                        android:padding="8dp"
                        android:text="ROB – Robot Vision"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• OF (Optical Flow): Motion vectors as colored arrows\n• SEG (Segmentation): AI image segmentation\n• DEPTH: AI depth map (near = bright, far = dark); use Focus slider to emphasize a depth band\n• DET: Object detection with bounding boxes\n• TXT: Text detection and translation (choose English → Spanish in the Translation dropdown to overlay Spanish at text locations)"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <!-- Camera Controls Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Camera controls"
                    android:textColor="@android:color/holo_green_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="• Switch camera: Front / rear\n• Gallery: Photos and videos saved by the app\n• Center button: Take photo or start/stop video (mode set by Photo/Video buttons)\n• Photo / Video: Green = unselected, red = selected; tap to switch capture mode"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Tips -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Tips"
                    android:textColor="@android:color/holo_blue_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="• Only one enhancement mode at a time\n• Sliders: tap the arrow above the controls to expand/collapse\n• Histogram: real-time color distribution\n• FPS: current frame rate\n• Overlays auto-hide after a few seconds\n• Tap the ℹ button again to close this guide"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </ScrollView>

        <!-- Contact us -->
        <Button
            android:id="@+id/contactUsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_info_background"
            android:text="Contact us"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Camera Controls Container -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/controls_background"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Night Vision Slider (Above Controls) -->
        <LinearLayout
            android:id="@+id/nightVisionSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="NV Intensity"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/nightVisionSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="@android:color/holo_green_light"
                android:thumbTint="@android:color/holo_green_light" />

        </LinearLayout>

        <!-- ML Night Vision Slider (Above Controls) -->
        <LinearLayout
            android:id="@+id/mlNightVisionSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ML Sensitivity"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/mlNightVisionSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="70"
                android:progressTint="@android:color/holo_blue_light"
                android:thumbTint="@android:color/holo_blue_light" />

        </LinearLayout>

        <!-- Edge Detection Slider (Above Controls) -->
        <LinearLayout
            android:id="@+id/edgeDetectionSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Edge Sensitivity"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/edgeDetectionSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="@android:color/holo_orange_light"
                android:thumbTint="@android:color/holo_orange_light" />

        </LinearLayout>

        <!-- HD Slider (Above Controls) -->
        <LinearLayout
            android:id="@+id/hdSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="HD (IMG): Scale 0.01x ↔ 4x"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/hdSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="@android:color/holo_purple"
                android:thumbTint="@android:color/holo_purple" />

            <TextView
                android:id="@+id/hdScaleValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Scale: 1.0x"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Color Adjustment Slider (Above Controls) -->
        <LinearLayout
            android:id="@+id/colorSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Color Adjustment"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Red Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="Red:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/redSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="@android:color/holo_red_dark"
                    android:thumbTint="@android:color/holo_red_dark" />

                <TextView
                    android:id="@+id/redValueText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />

            </LinearLayout>

            <!-- Green Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="Green:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/greenSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="@android:color/holo_green_dark"
                    android:thumbTint="@android:color/holo_green_dark" />

                <TextView
                    android:id="@+id/greenValueText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />

            </LinearLayout>

            <!-- Blue Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="Blue:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/blueSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="@android:color/holo_blue_dark"
                    android:thumbTint="@android:color/holo_blue_dark" />

                <TextView
                    android:id="@+id/blueValueText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Segmentation Slider (Above Controls) -->
        <LinearLayout
            android:id="@+id/segmentationSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Segmentation"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segments:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:minWidth="70dp" />

                <SeekBar
                    android:id="@+id/segmentationClustersSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="7"
                    android:progress="1"
                    android:progressTint="@android:color/holo_purple"
                    android:thumbTint="@android:color/holo_purple" />

                <TextView
                    android:id="@+id/segmentationClustersValueText"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refinement:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:minWidth="70dp" />

                <SeekBar
                    android:id="@+id/segmentationIterationsSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="12"
                    android:progress="3"
                    android:progressTint="@android:color/holo_purple"
                    android:thumbTint="@android:color/holo_purple" />

                <TextView
                    android:id="@+id/segmentationIterationsValueText"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Depth Field Slider (Above Controls) -->
        <LinearLayout
            android:id="@+id/depthFieldSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Depth Field"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:minWidth="70dp" />

                <SeekBar
                    android:id="@+id/depthFieldFocusSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@android:color/holo_blue_dark"
                    android:thumbTint="@android:color/holo_blue_dark" />

                <TextView
                    android:id="@+id/depthFieldFocusValueText"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Translation options (when TXT / Text Translation is selected) -->
        <LinearLayout
            android:id="@+id/translationOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/slider_background"
            android:padding="12dp"
            android:visibility="gone">

            <!-- From / To row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From:"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/translationFromSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:background="@drawable/button_info_background"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To:"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/translationToSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:background="@drawable/button_info_background"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Shown only when selected pair needs download -->
            <LinearLayout
                android:id="@+id/translationDownloadSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/translationDownloadPairButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Download English → Spanish"
                    android:textSize="12sp"
                    android:contentDescription="Download translation model for selected pair" />

            </LinearLayout>

            <Button
                android:id="@+id/translationViewAvailableButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="View available translators"
                android:textSize="12sp"
                android:contentDescription="List downloaded translation models and remove from device" />

        </LinearLayout>

        <!-- Night Vision Overlay Row -->
        <LinearLayout
            android:id="@+id/nightVisionOverlayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/glassy_green"
            android:visibility="gone">

            <!-- Regular Night Vision Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nvRegularButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Night Vision"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- Night Vision ML Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nvMLButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Night Vision ML"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

        </LinearLayout>

        <!-- IMG Overlay Row (ED and COL) -->
        <LinearLayout
            android:id="@+id/imgOverlayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/glassy_green"
            android:visibility="gone">

            <!-- Edge Detection Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/imgEDButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="ED"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- Color Adjustment Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/imgCOLButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="COL"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- HD Button (scale only, separate from ED/COL) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/imgHDButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="HD"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

        </LinearLayout>

        <!-- ROB Overlay Row (Optical Flow and Segmentation) -->
        <LinearLayout
            android:id="@+id/robOverlayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/glassy_green"
            android:visibility="gone">

            <!-- Optical Flow Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/robOFButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="OF"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- Segmentation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/robSEGButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="SEG"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- Depth Field Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/robDFButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="DF"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- Text Translation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/robTxtButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="TXT - Text detection and translation"
                android:text="TXT"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

        </LinearLayout>

        <!-- Night Vision Controls (Above Bottom Bar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <!-- Night Vision Button (NV) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nightVisionButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:contentDescription="NV - Night Vision modes"
                android:text="NV"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- IMG Button (Image processing) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/imgButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="IMG - Image effects (Edges, Color)"
                android:text="IMG"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- ROB Button (Robot vision) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/robButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="ROB - Optical Flow, Segmentation"
                android:text="ROB"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white" />

            <!-- Hide/Show Button - Pushed to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/sliderArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="@android:color/white" />

        </LinearLayout>

        <!-- Bottom Controls Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Camera Switch Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/cameraSwitchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Switch between front and rear camera"
                android:src="@drawable/ic_switch_camera"
                app:backgroundTint="@color/glassy_green"
                app:tint="@android:color/white" />

            <!-- Saved media / Gallery Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/galleryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/cameraSwitchButton"
                android:layout_marginStart="8dp"
                android:layout_centerVertical="true"
                android:contentDescription="View saved photos and videos"
                android:src="@drawable/ic_gallery"
                app:backgroundTint="@color/glassy_green"
                app:tint="@android:color/white" />

            <!-- Record Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/recordButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true"
                android:contentDescription="Take photo or start/stop video recording"
                android:src="@drawable/ic_record"
                app:backgroundTint="@android:color/holo_red_dark"
                app:tint="@android:color/white" />

            <!-- Photo Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/photoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/recordButton"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:contentDescription="Photo mode"
                android:src="@drawable/ic_photo"
                app:backgroundTint="@color/glassy_green"
                app:tint="@android:color/white" />

            <!-- Video Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/videoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/photoButton"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:contentDescription="Video mode"
                android:src="@drawable/ic_video"
                app:backgroundTint="@color/glassy_green"
                app:tint="@android:color/white" />

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 